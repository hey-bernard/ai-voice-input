{
  "name": "voice-input",
  "productName": "AI 음성 입력",
  "version": "0.1.0",
  "description": "어느 앱에서나 말하면 다듬어진 문장으로 입력해 주는 AI 음성 입력 앱",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "openai": "^7.65.0"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "app.voiceinput.desktop",
    "files": ["src/**/*", "package.json"],
    "icon": "src/assets/icon.png",
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg"],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "말한 내용을 받아쓰기 위해 마이크를 사용합니다."
      }
    },
    "win": { "target": ["nsis"] },
    "linux": { "target": ["AppImage"] }
  }
}
